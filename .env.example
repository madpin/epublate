# epublate — local environment template.
#
# Copy to `.env` (gitignored) and fill in the secrets you actually want
# active for your shell session:
#
#   cp .env.example .env
#
# The CLI auto-loads `.env` from the current working directory, then
# `<project_dir>/.env` for project-scoped subcommands. Real shell
# variables always win (override=False), and pytest skips loading
# entirely so the test suite stays hermetic.
#
# Disable loading without deleting the file:
#   EPUBLATE_DISABLE_DOTENV=1
#
# See `src/epublate/llm/factory.py` for how these are consumed.

# OpenAI-compatible LLM endpoint (PRD F-LLM-1). Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1   (Ollama)
EPUBLATE_LLM_BASE_URL=https://api.openai.com/v1

# API key for the endpoint above. Leave blank for anonymous local
# servers (vLLM, llama.cpp, Ollama).
EPUBLATE_LLM_API_KEY=

# Translator model. Required when not running with --mock-llm.
# Matches the in-code DEFAULT_MODEL fallback so swapping ``.env`` on
# and off doesn't change which model the Dashboard / Reader pick.
EPUBLATE_LLM_MODEL=gpt-5-mini

# Optional cheap model for the M5 helper-LLM extractor. Falls back to
# EPUBLATE_LLM_MODEL when unset (PRD F-LLM-2).
# EPUBLATE_LLM_HELPER_MODEL=gpt-5-mini

# Optional org header for the OpenAI-compatible endpoint.
# EPUBLATE_LLM_ORG=
